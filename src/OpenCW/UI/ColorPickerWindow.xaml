<Window x:Class="OpenCW.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCW - Özel Renk Seçici"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Dialog Container -->
    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- 2D Saturation/Value Canvas -->
                <RowDefinition Height="Auto"/> <!-- 1D Hue Slider Bar -->
                <RowDefinition Height="Auto"/> <!-- Dual Preview & Numeric Inputs -->
                <RowDefinition Height="Auto"/> <!-- Quick Swatches -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 0: Header with Drag & Close -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDialogTitle" Text="Özel Renk Seçici" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="24" Height="24" 
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" 
                        FontSize="11" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBrd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBrd" Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 1: 2D Saturation / Value Box -->
            <Border Grid.Row="1" Height="160" CornerRadius="8" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1" Cursor="Cross"
                    MouseDown="SvBox_MouseDown" MouseMove="SvBox_MouseMove" MouseUp="SvBox_MouseUp">
                <Grid x:Name="GridSvBox">
                    <!-- Layer 1: Horizontal gradient (White -> Pure Hue) -->
                    <Rectangle x:Name="RectHueBase">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop x:Name="StopHueColor" Color="#FF0000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Layer 2: Vertical gradient (Transparent -> Black) -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop Color="#FF000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Layer 3: Interactive Reticle Selector Indicator -->
                    <Canvas x:Name="CanvasReticle" IsHitTestVisible="False">
                        <Ellipse x:Name="Reticle" Width="14" Height="14" 
                                 Stroke="#FFFFFF" StrokeThickness="2" 
                                 Fill="Transparent" Canvas.Left="0" Canvas.Top="0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 2: 1D Hue Bar -->
            <Border Grid.Row="2" Height="14" CornerRadius="7" ClipToBounds="True" Margin="0,10,0,0"
                    BorderBrush="#334155" BorderThickness="1" Cursor="Hand"
                    MouseDown="HueBar_MouseDown" MouseMove="HueBar_MouseMove" MouseUp="HueBar_MouseUp">
                <Grid x:Name="GridHueBar">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0000" Offset="0.0"/>
                                <GradientStop Color="#FFFF00" Offset="0.17"/>
                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                <GradientStop Color="#00FFFF" Offset="0.50"/>
                                <GradientStop Color="#0000FF" Offset="0.67"/>
                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                <GradientStop Color="#FF0000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Hue Thumb Indicator -->
                    <Canvas x:Name="CanvasHueThumb" IsHitTestVisible="False">
                        <Border x:Name="HueThumb" Width="8" Height="14" CornerRadius="3"
                                Background="#FFFFFF" BorderBrush="#0F172A" BorderThickness="1.5"
                                Canvas.Left="0" Canvas.Top="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 3: Dual Color Preview + Numeric Controls -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/> <!-- Dual Preview -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="80"/> <!-- HEX Input -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>  <!-- R, G, B Inputs -->
                </Grid.ColumnDefinitions>

                <!-- Dual Preview Box: Left = Previous, Right = New -->
                <Border Grid.Column="0" Height="32" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="BrdOldColor" Background="#00B4FF" ToolTip="Önceki Renk"/>
                        <Border Grid.Column="1" x:Name="BrdNewColor" Background="#00B4FF" ToolTip="Yeni Renk"/>
                    </Grid>
                </Border>

                <!-- HEX Box -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="HEX" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtHexInput" Style="{StaticResource NumericTextBoxStyle}" Height="24" Text="#00B4FF" MaxLength="7"
                             TextChanged="TxtHexInput_TextChanged"/>
                </StackPanel>

                <!-- RGB Inputs (R, G, B side-by-side) -->
                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="R" FontSize="9" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtRInput" Style="{StaticResource NumericTextBoxStyle}" Height="24" Text="0" MaxLength="3"
                                 TextChanged="TxtRgbInput_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="G" FontSize="9" FontWeight="SemiBold" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtGInput" Style="{StaticResource NumericTextBoxStyle}" Height="24" Text="180" MaxLength="3"
                                 TextChanged="TxtRgbInput_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="B" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtBInput" Style="{StaticResource NumericTextBoxStyle}" Height="24" Text="255" MaxLength="3"
                                 TextChanged="TxtRgbInput_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 4: Quick Swatches Grid (16 curated colors) -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock x:Name="TxtSwatchesTitle" Text="Hızlı Renk Paleti" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FF003C" Tag="#FF003C" ToolTip="Neon Red" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FF5500" Tag="#FF5500" ToolTip="Electric Orange" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFAA00" Tag="#FFAA00" ToolTip="Amber" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFEA00" Tag="#FFEA00" ToolTip="Cyber Yellow" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#00FF66" Tag="#00FF66" ToolTip="Emerald Green" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#00FFAA" Tag="#00FFAA" ToolTip="Mint" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#00E5FF" Tag="#00E5FF" ToolTip="Excalibur Cyan" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#0077FF" Tag="#0077FF" ToolTip="Electric Blue" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#4400FF" Tag="#4400FF" ToolTip="Deep Indigo" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#9900FF" Tag="#9900FF" ToolTip="Neon Purple" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FF00AA" Tag="#FF00AA" ToolTip="Hot Pink" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FF3366" Tag="#FF3366" ToolTip="Crimson Rose" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="Pure White" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#FFE4C4" Tag="#FFE4C4" ToolTip="Warm White" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#A0E0FF" Tag="#A0E0FF" ToolTip="Ice Blue" Click="Swatch_Click"/>
                    <Button Style="{StaticResource SwatchButtonStyle}" Background="#A0FFD0" Tag="#A0FFD0" ToolTip="Aqua Mist" Click="Swatch_Click"/>
                </WrapPanel>
            </StackPanel>

            <!-- 5: Action Buttons (Cancel / Apply) -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancel" Grid.Column="0" Content="İptal" Style="{StaticResource DialogButtonStyle}" Click="BtnCancel_Click"/>
                <Button x:Name="BtnApply" Grid.Column="2" Content="Uygula" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnApply_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
