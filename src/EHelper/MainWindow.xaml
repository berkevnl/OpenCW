<Window x:Class="EHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EHelper"
        mc:Ignorable="d"
        Title="E-Helper"
        Height="680" 
        Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Modern Dark Slate Color Palette -->
        <SolidColorBrush x:Key="BgBrush" Color="#0B0F19"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#151D2E"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1C273C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#22304A"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00B4D8"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

        <!-- Mode Button Base Style -->
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#151D2E"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#22304A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2A42"/>
                                <Setter Property="BorderBrush" Value="#00B4D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Mode Button Style -->
        <Style x:Key="ActiveModeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModeButtonStyle}">
            <Setter Property="Background" Value="#0A3656"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#00B4D8"/>
        </Style>

        <!-- Round Color Preset Button -->
        <Style x:Key="ColorPresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#334155" StrokeThickness="1"/>
                            <Ellipse x:Name="highlight" Stroke="White" StrokeThickness="2" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="highlight" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow & Rounded Container -->
    <Border Margin="10" 
            Background="{StaticResource BgBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Footer / Status -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0" Padding="16,14,14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Monogram -->
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00B4D8" Offset="0.0"/>
                                    <GradientStop Color="#4F46E5" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="E" FontWeight="Bold" FontSize="18" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="E-Helper" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="v1.0" FontSize="11" Margin="6,3,0,0" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtModelBadge" Text="Casper Excalibur G920" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Header Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCloseToTray" Content="✕" Width="28" Height="28" 
                                Foreground="{StaticResource TextMuted}" Background="Transparent" BorderThickness="0" 
                                FontSize="13" Cursor="Hand" ToolTip="Gizle" Click="BtnCloseToTray_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Scrollable Body Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                <StackPanel>

                    <!-- Section: Donanım Telemetrisi (Canlı İzleme) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Card -->
                        <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="CPU" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtCpuTemp" Text="-- °C" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyan}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="🌀 Fan:" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtCpuRpm" Text="-- RPM" FontSize="11" Margin="4,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <!-- Temperature Mini Progress -->
                                <ProgressBar x:Name="PbCpuTemp" Height="4" Margin="0,8,0,0" Value="45" Maximum="100" 
                                             Foreground="{StaticResource AccentCyan}" Background="#0F172A" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Card -->
                        <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="GPU" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtGpuTemp" Text="-- °C" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPurple}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="🌀 Fan:" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtGpuRpm" Text="-- RPM" FontSize="11" Margin="4,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                                <!-- Temperature Mini Progress -->
                                <ProgressBar x:Name="PbGpuTemp" Height="4" Margin="0,8,0,0" Value="40" Maximum="100" 
                                             Foreground="{StaticResource AccentPurple}" Background="#0F172A" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Section: Performans Profilleri -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PERFORMANS PROFİLİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Office / Quiet Button -->
                                <Button x:Name="BtnModeOffice" Grid.Column="0" Style="{StaticResource ModeButtonStyle}" Click="BtnModeOffice_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🍃" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ofis / Sessiz" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Gaming Button -->
                                <Button x:Name="BtnModeGaming" Grid.Column="2" Style="{StaticResource ActiveModeButtonStyle}" Click="BtnModeGaming_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⚖️" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Dengeli / Oyun" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- High Performance Button -->
                                <Button x:Name="BtnModeHighPerf" Grid.Column="4" Style="{StaticResource ModeButtonStyle}" Click="BtnModeHighPerf_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Performans" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section: RGB Klavye Aydınlatması -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="KLAVYE AYDINLATMA (RGB)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <Border x:Name="BrdCurrentColor" HorizontalAlignment="Right" Width="18" Height="18" CornerRadius="9" Background="#00B4D8" BorderBrush="#334155" BorderThickness="1"/>
                            </Grid>

                            <!-- LED Modes -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnLedStatic" Grid.Column="0" Content="Sabit" Style="{StaticResource ActiveModeButtonStyle}" FontSize="11" Padding="2,6" Click="BtnLedStatic_Click"/>
                                <Button x:Name="BtnLedBreathing" Grid.Column="2" Content="Nefes" Style="{StaticResource ModeButtonStyle}" FontSize="11" Padding="2,6" Click="BtnLedBreathing_Click"/>
                                <Button x:Name="BtnLedCycle" Grid.Column="4" Content="Döngü" Style="{StaticResource ModeButtonStyle}" FontSize="11" Padding="2,6" Click="BtnLedCycle_Click"/>
                                <Button x:Name="BtnLedOff" Grid.Column="6" Content="Kapalı" Style="{StaticResource ModeButtonStyle}" FontSize="11" Padding="2,6" Click="BtnLedOff_Click"/>
                            </Grid>

                            <!-- Brightness Slider -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Parlaklık" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider x:Name="SliderBrightness" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="4" Value="3" 
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderBrightness_ValueChanged"/>
                                <TextBlock x:Name="TxtBrightnessValue" Grid.Column="2" Text="3" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Quick Preset Colors -->
                            <TextBlock Text="Hızlı Renkler" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#00E5FF" ToolTip="Cyan" Tag="#00E5FF" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#3B82F6" ToolTip="Mavi" Tag="#3B82F6" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#10B981" ToolTip="Yeşil" Tag="#10B981" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#F59E0B" ToolTip="Turuncu" Tag="#F59E0B" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#EF4444" ToolTip="Kırmızı" Tag="#EF4444" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#8B5CF6" ToolTip="Mor" Tag="#8B5CF6" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#EC4899" ToolTip="Pembe" Tag="#EC4899" Click="ColorPreset_Click"/>
                                <Button Style="{StaticResource ColorPresetButtonStyle}" Background="#FFFFFF" ToolTip="Beyaz" Tag="#FFFFFF" Click="ColorPreset_Click"/>
                            </StackPanel>

                            <!-- Custom HEX Color Input -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtHexColor" Text="#00B4D8" MaxLength="7" 
                                         Background="#0B0F19" Foreground="{StaticResource TextPrimary}" 
                                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                                         Padding="8,5" FontSize="11" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnApplyHex" Grid.Column="2" Content="Rengi Uygula" Style="{StaticResource ModeButtonStyle}" 
                                        FontSize="11" Padding="10,5" Click="BtnApplyHex_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section: Hızlı Eylemler & Ayarlar -->
                    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <!-- Reset Fans to Auto -->
                            <Button x:Name="BtnResetFans" Content="🔄 Fanları Otomatik BIOS Kontrolüne Sıfırla" 
                                    Style="{StaticResource ModeButtonStyle}" Margin="0,0,0,8" FontSize="11" Padding="8,7" Click="BtnResetFans_Click"/>

                            <!-- Windows Startup Checkbox -->
                            <CheckBox x:Name="ChkAutoStart" Content="Windows ile Birlikte Başlat" 
                                      Foreground="{StaticResource TextSecondary}" FontSize="11" 
                                      VerticalContentAlignment="Center" Margin="2,4,0,0" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Bar -->
            <Border Grid.Row="2" Padding="14,10" Background="#0C1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Connection Pulse Dot -->
                        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtHardwareStatus" Text="WMI ACPI SMI • Bağlı" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <Button x:Name="BtnExitApp" Content="Çıkış" HorizontalAlignment="Right" 
                            Foreground="{StaticResource DangerRed}" Background="Transparent" BorderThickness="0" 
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="BtnExitApp_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
